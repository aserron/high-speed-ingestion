# Staging Environment Configuration
# This file overrides base configuration for staging deployment

# Application Settings
NODE_ENV=staging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Database Settings (Staging)
DB_HOST=${STAGING_DB_HOST}
DB_PORT=5432
DB_NAME=finance_benchmark_staging
DB_USERNAME=${STAGING_DB_USERNAME}
DB_PASSWORD=${STAGING_DB_PASSWORD}
DB_SSL=true
DB_POOL_MAX=8

# Redis Settings (Staging)
REDIS_HOST=${STAGING_REDIS_HOST}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}

# WebSocket Settings (Staging)
WS_PORT=8080
WS_MAX_CONNECTIONS=500
WS_HEARTBEAT_INTERVAL=30000

# Security Settings (Staging)
CORS_ORIGIN=${STAGING_CORS_ORIGIN}
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900

# SSL/TLS (Staging)
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/staging.crt
SSL_KEY_PATH=/etc/ssl/private/staging.key

# Monitoring (Staging)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Performance Settings (Staging)
ENABLE_CLUSTERING=true
CLUSTER_WORKERS=2

# Backup Settings (Staging)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_BUCKET=${STAGING_BACKUP_BUCKET}

# Environment Metadata
DEPLOYMENT_ENVIRONMENT=staging
DEPLOYMENT_VERSION=${CI_COMMIT_TAG:-latest}
BUILD_NUMBER=${CI_PIPELINE_ID}
GIT_COMMIT_HASH=${CI_COMMIT_SHA}