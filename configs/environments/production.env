# Production Environment Configuration
# This file overrides base configuration for production deployment

# Application Settings
NODE_ENV=production
LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false

# Database Settings (Production)
DB_HOST=${PROD_DB_HOST}
DB_PORT=5432
DB_NAME=finance_benchmark
DB_USERNAME=${PROD_DB_USERNAME}
DB_PASSWORD=${PROD_DB_PASSWORD}
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=10000

# Redis Settings (Production)
REDIS_HOST=${PROD_REDIS_HOST}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${PROD_REDIS_PASSWORD}
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# WebSocket Settings (Production)
WS_PORT=8080
WS_MAX_CONNECTIONS=10000
WS_HEARTBEAT_INTERVAL=30000
WS_COMPRESSION=true

# Security Settings (Production)
CORS_ORIGIN=${PROD_CORS_ORIGIN}
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=5000
RATE_LIMIT_WINDOW=900

# SSL/TLS (Production)
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/production.crt
SSL_KEY_PATH=/etc/ssl/private/production.key
SSL_VERIFY_CLIENT=false

# Monitoring (Production)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Performance Settings (Production)
ENABLE_CLUSTERING=true
CLUSTER_WORKERS=auto
ENABLE_GRACEFUL_SHUTDOWN=true
SHUTDOWN_TIMEOUT=30000

# Backup Settings (Production)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_BUCKET=${PROD_BACKUP_BUCKET}
BACKUP_ENCRYPTION=true

# Load Balancer (Production)
LB_ENABLED=true
LB_ALGORITHM=least_connections
LB_HEALTH_CHECK_PATH=/health
LB_HEALTH_CHECK_INTERVAL=5
LB_HEALTH_CHECK_TIMEOUT=3

# Environment Metadata
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_VERSION=${CI_COMMIT_TAG}
BUILD_NUMBER=${CI_PIPELINE_ID}
GIT_COMMIT_HASH=${CI_COMMIT_SHA}
DEPLOYMENT_TIMESTAMP=${CI_JOB_STARTED_AT}