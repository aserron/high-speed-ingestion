# Development Environment Configuration
# This file overrides base configuration for local development

# Application Settings
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# Development-specific Features
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_MODE=true
ENABLE_PROFILING=false

# Database Settings (Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_benchmark_dev
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
DB_SSL=false
DB_POOL_MAX=5

# Redis Settings (Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# WebSocket Settings (Development)
WS_PORT=8080
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=10000

# Security Settings (Development)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=false

# Monitoring (Development)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Performance Settings (Development)
ENABLE_CLUSTERING=false
CLUSTER_WORKERS=1

# Development Tools
ENABLE_API_DOCS=true
API_DOCS_PATH=/docs
ENABLE_SWAGGER=true
SWAGGER_PATH=/swagger