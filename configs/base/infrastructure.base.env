# Base Infrastructure Configuration
# This file contains default values for infrastructure and monitoring settings
# Override these values in environment-specific files

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_ENABLED=false
GRAFANA_PORT=3001

# Docker Configuration
DOCKER_NETWORK=finance_benchmark_network
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_LOG_DRIVER=json-file
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Load Balancer Configuration
LB_ENABLED=false
LB_ALGORITHM=round_robin
LB_HEALTH_CHECK_PATH=/health
LB_HEALTH_CHECK_INTERVAL=10
LB_HEALTH_CHECK_TIMEOUT=5

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_TYPE=local
BACKUP_STORAGE_PATH=/backups

# SSL/TLS Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem
SSL_CA_PATH=/certs/ca.pem
SSL_VERIFY_CLIENT=false

# Environment Metadata
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_TIMESTAMP=
BUILD_NUMBER=
GIT_COMMIT_HASH=