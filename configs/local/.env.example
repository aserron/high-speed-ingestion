# Local Development Environment Variables
# Copy this file to .env.local and customize for your local setup
# This file should NOT be committed to version control

# Override any base or environment-specific settings here
# Examples:

# Database (if using different local database)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=finance_benchmark_local
# DB_USERNAME=myuser
# DB_PASSWORD=mypassword

# Redis (if using different local Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6380
# REDIS_PASSWORD=myredispassword

# Application (for local debugging)
# LOG_LEVEL=debug
# ENABLE_DEBUG_MODE=true
# PORT=3001

# WebSocket (for local testing)
# WS_PORT=8081
# WS_MAX_CONNECTIONS=10

# Development Tools
# ENABLE_API_DOCS=true
# ENABLE_SWAGGER=true

# Performance (for local development)
# ENABLE_CLUSTERING=false
# CLUSTER_WORKERS=1

# Monitoring (optional for local)
# PROMETHEUS_ENABLED=false
# GRAFANA_ENABLED=false