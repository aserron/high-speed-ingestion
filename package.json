{
  "name": "finance-ingestion-benchmark",
  "version": "1.0.0",
  "description": "High-performance financial data ingestion benchmark comparing Python and Node.js implementations",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "benchmark": "turbo run benchmark",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "setup": "npm install && turbo run setup",
    "setup:dev": "node scripts/setup-dev.js || powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "format": "turbo run format",
    "type-check": "turbo run type-check",
    "start": "turbo run start",
    "start:python": "turbo run start --filter=python-ingestion",
    "start:node": "turbo run start --filter=node-ingestion",
    "benchmark:compare": "turbo run benchmark && node scripts/compare-results.js"
  },
  "devDependencies": {
    "turbo": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aserron/high-speed-ingestion.git"
  },
  "keywords": [
    "finance",
    "ingestion",
    "benchmark",
    "python",
    "nodejs",
    "websocket",
    "performance"
  ],
  "author": "aserron",
  "license": "MIT"
}