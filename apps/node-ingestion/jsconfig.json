{
  "$schema": "https://json.schemastore.org/jsconfig",
  "compilerOptions": {
    // Module system configuration
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",

    // Enable all modern JavaScript features
    "allowJs": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": false,

    // Path resolution
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tests/*": [
        "src/__tests__/*",
        "src/components/__tests__/*",
        "src/utils/__tests__/*"
      ]
    },

    // Modern JavaScript support
    "lib": ["ES2022", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": true,

    // Strict type checking (disabled for this JS project)
    "strict": false,

    // Module detection
    "moduleDetection": "force"
  },
  // Include patterns
  "include": ["src/**/*", "**/*.mjs", "jest.config.mjs", "jest.setup.mjs"],
  // Exclude patterns
  "exclude": ["node_modules", "coverage", "dist", "build", ".jest-cache"],
  // Type acquisition for better intellisense
  "typeAcquisition": {
    "enable": true,
    "include": ["jest", "node"]
  }
}