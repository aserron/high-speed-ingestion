# Example Environment Configuration for Node.js Finance Ingestion
# Copy this file to .env and modify values as needed

# Application Settings
APP_NAME=finance-ingestion-nodejs
APP_VERSION=1.0.0
NODE_ENV=development
ENVIRONMENT=development
DEBUG=false
VERBOSE=false
DRY_RUN=false

# WebSocket Configuration
WEBSOCKET_URL=wss://localhost:8080/market-data
WEBSOCKET_CONNECT_TIMEOUT_MS=5000
WEBSOCKET_PING_INTERVAL_MS=30000
WEBSOCKET_PONG_TIMEOUT_MS=5000
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10
WEBSOCKET_RECONNECT_DELAY_MS=100
WEBSOCKET_RECONNECT_BACKOFF_MULTIPLIER=2.0
WEBSOCKET_RECONNECT_MAX_DELAY_MS=30000
WEBSOCKET_RECONNECT_JITTER_MS=1000
WEBSOCKET_MAX_MESSAGE_SIZE=1048576
WEBSOCKET_COMPRESSION_ENABLED=true
WEBSOCKET_TLS_ENABLED=true
WEBSOCKET_TLS_VERIFY_CERTIFICATE=true

# Processing Configuration
PROCESSING_BATCH_SIZE=100
PROCESSING_BATCH_TIMEOUT_MS=10
PROCESSING_MAX_QUEUE_SIZE=10000
PROCESSING_BACKPRESSURE_THRESHOLD=0.8
PROCESSING_DROP_OLDEST_ON_BACKPRESSURE=true
PROCESSING_LATENCY_MEASUREMENT_ENABLED=true
PROCESSING_METRICS_COLLECTION_INTERVAL_MS=1000
PROCESSING_VALIDATE_INCOMING_MESSAGES=true
PROCESSING_STRICT_SCHEMA_VALIDATION=false

# Clustering Configuration
CLUSTER_ENABLED=true
CLUSTER_WORKERS=0
CLUSTER_RESTART_DELAY=1000
CLUSTER_MAX_RESTARTS=10
CLUSTER_GRACEFUL_SHUTDOWN_TIMEOUT=10000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_MIN_CONNECTIONS=2
REDIS_ACQUIRE_TIMEOUT_MS=5000
REDIS_SOCKET_KEEPALIVE=true
REDIS_KEY_PREFIX=
REDIS_RETRY_DELAY_ON_FAILOVER=100
REDIS_MAX_RETRIES_PER_REQUEST=3

# PostgreSQL Configuration
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=finance_benchmark
POSTGRESQL_USERNAME=benchmark_user
POSTGRESQL_PASSWORD=benchmark_pass
POSTGRESQL_MAX_CONNECTIONS=20
POSTGRESQL_MIN_CONNECTIONS=5
POSTGRESQL_ACQUIRE_TIMEOUT_MS=5000
POSTGRESQL_IDLE_TIMEOUT_MS=30000
POSTGRESQL_STATEMENT_TIMEOUT_MS=30000
POSTGRESQL_QUERY_TIMEOUT_MS=30000
POSTGRESQL_SSL_ENABLED=false

# Buffer Configuration
BUFFER_MAX_SIZE=100000
BUFFER_FLUSH_INTERVAL_MS=1000
BUFFER_FLUSH_THRESHOLD=1000
BUFFER_CIRCULAR_BUFFER=true

# Monitoring Configuration
MONITORING_PROMETHEUS_ENABLED=true
MONITORING_PROMETHEUS_PORT=9090
MONITORING_PROMETHEUS_PATH=/metrics
MONITORING_LOG_LEVEL=info
MONITORING_LOG_FORMAT=json
MONITORING_LOG_TIMESTAMPS=true
MONITORING_HEALTH_CHECK_ENABLED=true
MONITORING_HEALTH_CHECK_PORT=8080
MONITORING_HEALTH_CHECK_PATH=/health
MONITORING_HEALTH_CHECK_INTERVAL_MS=5000
MONITORING_TRACK_RESOURCE_USAGE=true
MONITORING_RESOURCE_USAGE_INTERVAL_MS=1000
MONITORING_TRACK_GARBAGE_COLLECTION=true

# Benchmark Configuration
BENCHMARK_DURATION_MS=60000
BENCHMARK_WARMUP_MS=10000
BENCHMARK_COOLDOWN_MS=5000
BENCHMARK_MESSAGE_RATE_PER_SECOND=10000
BENCHMARK_BURST_MODE_ENABLED=true
BENCHMARK_BURST_INTERVAL_MS=10000
BENCHMARK_BURST_MULTIPLIER=5.0
BENCHMARK_SYMBOL_ROTATION_ENABLED=true
BENCHMARK_PRICE_RANGE_MIN=1.0
BENCHMARK_PRICE_RANGE_MAX=1000.0
BENCHMARK_QUANTITY_RANGE_MIN=1.0
BENCHMARK_QUANTITY_RANGE_MAX=10000.0
BENCHMARK_COLLECT_DETAILED_METRICS=true
BENCHMARK_SAVE_RESULTS_TO_DATABASE=true
BENCHMARK_EXPORT_RESULTS_PATH=