{
  "name": "finance-ingestion-nodejs",
  "version": "1.0.0",
  "description": "High-performance Node.js financial data ingestion system",
  "main": "src/app.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node --enable-source-maps src/app.js",
    "start:simple": "APP_MODE=simple node --enable-source-maps src/app.js",
    "start:full": "APP_MODE=full node --enable-source-maps src/app.js",
    "start:cluster": "APP_MODE=cluster node --enable-source-maps src/app.js",
    "dev": "APP_MODE=full node --enable-source-maps --inspect src/app.js",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "test:debug": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --inspect-brk\" jest --runInBand --no-cache",
    "test:ci": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --ci --watchAll=false --passWithNoTests",
    "test:unit": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --testPathPattern='\\.(test|spec)\\.(m)?js$'",
    "test:integration": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --testPathPattern='integration'",
    "test:changed": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --onlyChanged",
    "test:related": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --findRelatedTests",
    "benchmark": "node --enable-source-maps src/benchmark.js",
    "quality:check": "npm run lint:check && npm run format:check && npm run security:check",
    "quality:fix": "npm run lint:fix && npm run format:fix",
    "lint": "eslint src/ tests/",
    "lint:check": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/**/*.{js,mjs} tests/**/*.{js,mjs}",
    "format:check": "prettier --check src/**/*.{js,mjs} tests/**/*.{js,mjs}",
    "format:fix": "prettier --write src/**/*.{js,mjs} tests/**/*.{js,mjs}",
    "type:check": "echo 'TypeScript checking not configured for JavaScript project'",
    "security:check": "npm audit --audit-level=moderate && audit-ci --moderate",
    "build": "echo 'No build step required for Node.js'",
    "clean": "rm -rf coverage/ .nyc_output/ logs/",
    "validate-config": "node --enable-source-maps src/cli.js validate-config",
    "health-check": "node --enable-source-maps src/cli.js health-check"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "ajv": "^8.12.0",
    "async-hooks": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "msgpack5": "^6.0.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jest": "^30.0.0",
    "audit-ci": "^7.1.0",
    "benchmark": "^2.1.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },

  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "quoteProps": "as-needed"
  },
  "keywords": [
    "finance",
    "ingestion",
    "websocket",
    "performance",
    "benchmark",
    "nodejs",
    "clustering",
    "real-time"
  ],
  "author": "Finance Benchmark Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/finance-ingestion-benchmark"
  },
  "bugs": {
    "url": "https://github.com/your-org/finance-ingestion-benchmark/issues"
  },
  "homepage": "https://github.com/your-org/finance-ingestion-benchmark#readme"
}