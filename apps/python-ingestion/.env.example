# Example Environment Configuration
# Copy this file to .env and modify values as needed

# Application Settings
NAME=finance-ingestion-python
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
VERBOSE=false
DRY_RUN=false

# WebSocket Configuration
WEBSOCKET__URL=wss://localhost:8080/market-data
WEBSOCKET__CONNECT_TIMEOUT_MS=5000
WEBSOCKET__PING_INTERVAL_MS=30000
WEBSOCKET__PONG_TIMEOUT_MS=5000
WEBSOCKET__MAX_RECONNECT_ATTEMPTS=10
WEBSOCKET__RECONNECT_DELAY_MS=100
WEBSOCKET__RECONNECT_BACKOFF_MULTIPLIER=2.0
WEBSOCKET__RECONNECT_MAX_DELAY_MS=30000
WEBSOCKET__RECONNECT_JITTER_MS=1000
WEBSOCKET__MAX_MESSAGE_SIZE=1048576
WEBSOCKET__COMPRESSION_ENABLED=true
WEBSOCKET__TLS_ENABLED=true
WEBSOCKET__TLS_VERIFY_CERTIFICATE=true

# Processing Configuration
PROCESSING__BATCH_SIZE=100
PROCESSING__BATCH_TIMEOUT_MS=10
PROCESSING__MAX_QUEUE_SIZE=10000
PROCESSING__BACKPRESSURE_THRESHOLD=0.8
PROCESSING__DROP_OLDEST_ON_BACKPRESSURE=true
PROCESSING__LATENCY_MEASUREMENT_ENABLED=true
PROCESSING__METRICS_COLLECTION_INTERVAL_MS=1000
PROCESSING__VALIDATE_INCOMING_MESSAGES=true
PROCESSING__STRICT_SCHEMA_VALIDATION=false

# Redis Configuration
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__MAX_CONNECTIONS=10
REDIS__MIN_CONNECTIONS=2
REDIS__ACQUIRE_TIMEOUT_MS=5000
REDIS__SOCKET_KEEPALIVE=true
REDIS__KEY_PREFIX=

# PostgreSQL Configuration
POSTGRESQL__HOST=localhost
POSTGRESQL__PORT=5432
POSTGRESQL__DATABASE=finance_benchmark
POSTGRESQL__USERNAME=benchmark_user
POSTGRESQL__PASSWORD=benchmark_pass
POSTGRESQL__MAX_CONNECTIONS=20
POSTGRESQL__MIN_CONNECTIONS=5
POSTGRESQL__ACQUIRE_TIMEOUT_MS=5000
POSTGRESQL__IDLE_TIMEOUT_MS=30000
POSTGRESQL__STATEMENT_TIMEOUT_MS=30000
POSTGRESQL__QUERY_TIMEOUT_MS=30000
POSTGRESQL__SSL_ENABLED=false

# Buffer Configuration
BUFFER__MAX_SIZE=100000
BUFFER__FLUSH_INTERVAL_MS=1000
BUFFER__FLUSH_THRESHOLD=1000
BUFFER__CIRCULAR_BUFFER=true

# Monitoring Configuration
MONITORING__PROMETHEUS_ENABLED=true
MONITORING__PROMETHEUS_PORT=9090
MONITORING__PROMETHEUS_PATH=/metrics
MONITORING__LOG_LEVEL=INFO
MONITORING__LOG_FORMAT=json
MONITORING__LOG_TIMESTAMPS=true
MONITORING__HEALTH_CHECK_ENABLED=true
MONITORING__HEALTH_CHECK_PORT=8080
MONITORING__HEALTH_CHECK_PATH=/health
MONITORING__HEALTH_CHECK_INTERVAL_MS=5000
MONITORING__TRACK_RESOURCE_USAGE=true
MONITORING__RESOURCE_USAGE_INTERVAL_MS=1000
MONITORING__TRACK_GARBAGE_COLLECTION=true

# Benchmark Configuration
BENCHMARK__DURATION_MS=60000
BENCHMARK__WARMUP_MS=10000
BENCHMARK__COOLDOWN_MS=5000
BENCHMARK__MESSAGE_RATE_PER_SECOND=10000
BENCHMARK__BURST_MODE_ENABLED=true
BENCHMARK__BURST_INTERVAL_MS=10000
BENCHMARK__BURST_MULTIPLIER=5.0
BENCHMARK__SYMBOL_ROTATION_ENABLED=true
BENCHMARK__PRICE_RANGE_MIN=1.0
BENCHMARK__PRICE_RANGE_MAX=1000.0
BENCHMARK__QUANTITY_RANGE_MIN=1.0
BENCHMARK__QUANTITY_RANGE_MAX=10000.0
BENCHMARK__COLLECT_DETAILED_METRICS=true
BENCHMARK__SAVE_RESULTS_TO_DATABASE=true
BENCHMARK__EXPORT_RESULTS_PATH=