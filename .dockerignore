# Git
.git/
.gitignore
.gitattributes

# Documentation (exclude most, but allow app-specific docs)
README.md
docs/
docs-site/
*.md
# Allow app-specific documentation that might be needed
!apps/*/README.md
!apps/*/docs/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage and test results
coverage/
.nyc_output/
test-results/
benchmark-results/
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Node.js
node_modules/
.npm
.eslintcache
.yarn-integrity
.pnp
.pnp.js
.node_repl_history
*.tgz
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv/

# Infrastructure (Docker configs handled separately)
infrastructure/
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Development scripts (exclude most, allow essential ones)
scripts/
tools/
*.ps1
*.sh
# Allow essential scripts that might be needed in containers
!scripts/health-check.sh
!scripts/*-init.sh
!scripts/*.sql

# Testing (exclude test files from production builds)
tests/
benchmarks/
*.test.js
*.spec.js
test_*.py
*_test.py

# Configuration files (exclude most, allow essential ones)
.env*
!.env.example
.kiro/
configs/
turbo.json
# Allow essential config files
!apps/*/package.json
!packages/*/package.json
!apps/*/package-lock.json
!packages/*/package-lock.json
!apps/*/requirements.txt
!apps/*/pyproject.toml
!apps/*/Makefile

# Temporary and backup files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Analysis and project management files
branch_comparison_analysis.md
branch-analysis.md
development-history-table.md
main_vs_dev_comparison.md
pr-merge-sequence.md
github_project_structure.json
setup_github_project_complete.ps1

# Monorepo specific exclusions
.turbo/
.npmrc