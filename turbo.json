{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "__pycache__/**",
        ".vitepress/dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "serve": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**",
        ".pytest_cache/**",
        ".nyc_output/**"
      ],
      "inputs": [
        "src/**/*.py",
        "src/**/*.js",
        "src/**/*.ts",
        "tests/**/*",
        "test/**/*",
        "**/*.md",
        ".vitepress/**/*"
      ]
    },
    "lint": {
      "outputs": []
    },
    "benchmark": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": [
        "benchmark-results/**",
        "performance-logs/**"
      ]
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "cache": false
    },
    "format": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}