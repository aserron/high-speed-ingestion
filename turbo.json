{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "__pycache__/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", ".pytest_cache/**", ".nyc_output/**"],
      "inputs": ["src/**/*.py", "src/**/*.js", "src/**/*.ts", "tests/**/*", "test/**/*"]
    },
    "lint": {
      "outputs": []
    },
    "benchmark": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["benchmark-results/**", "performance-logs/**"]
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "cache": false
    }
  }
}