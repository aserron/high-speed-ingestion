# Development Environment Variables Template
# Copy this file to .env.dev and customize values as needed

# Application Environment
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Database Configuration
POSTGRES_DB=finance_benchmark_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/finance_benchmark_dev

# Redis Configuration
REDIS_URL=redis://redis:6379

# Python Service Configuration
PYTHON_LOG_LEVEL=DEBUG
PYTHON_RELOAD=true

# Node.js Service Configuration
NODE_LOG_LEVEL=debug
NODE_INSPECT_PORT=9229

# Resource Limits (Development)
PYTHON_CPU_LIMIT=1.0
PYTHON_MEMORY_LIMIT=2G
NODE_CPU_LIMIT=1.0
NODE_MEMORY_LIMIT=2G
REDIS_MEMORY_LIMIT=1G
POSTGRES_MEMORY_LIMIT=1G

# Development Features
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_PORTS=true
ENABLE_DEV_SEED=true