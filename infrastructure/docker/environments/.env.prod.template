# Production Environment Variables Template
# Copy this file to .env.prod and customize values as needed

# Application Environment
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# Database Configuration
POSTGRES_DB=finance_benchmark
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_URL=postgresql://postgres:your_secure_password_here@postgres:5432/finance_benchmark

# Redis Configuration
REDIS_URL=redis://redis:6379

# Python Service Configuration
PYTHON_LOG_LEVEL=INFO
PYTHON_RELOAD=false

# Node.js Service Configuration
NODE_LOG_LEVEL=info

# Resource Limits (Production)
PYTHON_CPU_LIMIT=2.0
PYTHON_MEMORY_LIMIT=4G
NODE_CPU_LIMIT=2.0
NODE_MEMORY_LIMIT=4G
REDIS_MEMORY_LIMIT=2G
POSTGRES_MEMORY_LIMIT=2G

# Production Features
ENABLE_HOT_RELOAD=false
ENABLE_DEBUG_PORTS=false
ENABLE_DEV_SEED=false

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30